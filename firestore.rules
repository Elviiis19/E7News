rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    match /settings/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    match /webstories/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
